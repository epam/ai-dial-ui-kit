{
  "name": "fixture-consumer-markdown-editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Consumer fixture: exercises the Markdown loaders and programmatically switches the lazy Markdown container to JSON mode. @uiw and Monaco must stay outside the initial graph, and Monaco must remain behind the container's nested dynamic import.",
  "scripts": {
    "build": "vite build",
    "assert": "node ../shared/assert-static-graph.mjs --dist dist --forbidden ag-grid-community,ag-grid-react,@monaco-editor/react,monaco-editor,@uiw/react-md-editor,@uiw/react-markdown-preview --dynamic-require @uiw/react-md-editor,@uiw/react-markdown-preview,@monaco-editor/react,monaco-editor --dynamic-after MarkdownEditorContainer:monaco-editor"
  },
  "dependencies": {
    "@epam/ai-dial-ui-kit": "file:../.tarballs/epam-ai-dial-ui-kit-0.0.0.tgz",
    "@floating-ui/react": "^0.27.19",
    "@monaco-editor/react": "^4.7.0",
    "@tabler/icons-react": "^3.41.1",
    "@uiw/react-markdown-preview": "^5.2.0",
    "@uiw/react-md-editor": "^4.1.0",
    "classnames": "^2.5.1",
    "monaco-editor": "^0.55.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.6.0",
    "vite": "^7.1.5"
  }
}
