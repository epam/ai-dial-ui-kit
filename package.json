{
  "name": "@epam/ai-dial-ui-kit",
  "version": "0.8.0-rc",
  "type": "module",
  "license": "Apache-2.0",
  "description": "A modern UI kit for building AI DIAL interfaces with React",
  "types": "dist/src/index.d.ts",
  "engines": {
    "node": ">=22.2.0",
    "npm": ">=10.7.0"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/dial-ui-kit.es.js",
      "require": "./dist/dial-ui-kit.cjs.js"
    },
    "./styles.css": {
      "require": "./dist/index.css",
      "default": "./dist/index.css"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css",
    "*.scss",
    "./src/styles/*",
    "./src/components/JsonEditor/*",
    "./src/components/MarkdownEditor/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:css",
    "build:css": "tailwindcss -m -i ./src/styles/tailwind-entry.scss -o ./dist/index.css",
    "lint": "eslint . --ext ts,tsx --fix --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --check .",
    "format-fix": "prettier --write .",
    "preview": "vite preview",
    "storybook": "concurrently \"npm run storybook:css\" \"storybook dev -p 6006\"",
    "storybook:css": "tailwindcss -w -i ./src/styles/tailwind-entry.scss -o ./src/index.css",
    "build-storybook": "concurrently \"npm run build-storybook:css\" \"storybook build\"",
    "build-storybook:css": "tailwindcss -m -i ./src/styles/tailwind-entry.scss -o ./src/index.css",
    "prepare": "husky",
    "publish": "node tools/publish-lib.mjs",
    "publish:dry": "node tools/publish-lib.mjs --output-style=static --dry",
    "test": "vitest --coverage",
    "storybook-docs": "storybook dev --docs",
    "build-storybook-docs": "storybook build --docs"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "npm run lint"
    ]
  },
  "overrides": {
    "esbuild": "0.25.9"
  },
  "dependencies": {
    "ag-grid-community": "^34.3.0",
    "ag-grid-react": "^34.3.0",
    "re-resizable": "^6.11.2",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "tailwind-merge": "^3.5.0"
  },
  "peerDependencies": {
    "@floating-ui/react": "^0.27.18",
    "@monaco-editor/react": "^4.7.0",
    "@tabler/icons-react": "^3.37.1",
    "@uiw/react-markdown-preview": "^5.1.5",
    "@uiw/react-md-editor": "^4.0.11",
    "classnames": "^2.5.1",
    "monaco-editor": "^0.52.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.1",
    "@eslint/compat": "^2.0.2",
    "@eslint/eslintrc": "^3.3.4",
    "@eslint/js": "^9.31.0",
    "@storybook/addon-a11y": "^10.2.13",
    "@storybook/addon-docs": "^10.2.13",
    "@storybook/addon-vitest": "^10.2.13",
    "@storybook/react-vite": "^10.2.13",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^28.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/browser": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-storybook": "^10.2.13",
    "eslint-plugin-tailwindcss": "^3.18.2",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "postcss-import": "^16.1.1",
    "prettier": "3.8.1",
    "sass": "^1.97.3",
    "storybook": "^10.2.13",
    "storybook-addon-pseudo-states": "^10.2.13",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^4.0.18"
  }
}
