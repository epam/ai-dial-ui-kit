{
  "name": "@epam/ai-dial-ui-kit",
  "version": "0.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "A modern UI kit for building AI DIAL interfaces with React",
  "types": "dist/src/index.d.ts",
  "engines": {
    "node": ">=22.2.0",
    "npm": ">=10.7.0"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/dial-ui-kit.es.js",
      "require": "./dist/dial-ui-kit.cjs.js"
    },
    "./styles.css": {
      "require": "./dist/index.css",
      "default": "./dist/index.css"
    }
  },
  "bin": {
    "ai-dial-ui-kit-mcp": "dist/mcp-server.cjs"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css",
    "*.scss",
    "./src/styles/*",
    "./src/components/JsonEditor/*",
    "./src/components/MarkdownEditor/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:css && npm run build:manifest && npm run build:mcp",
    "build:css": "tailwindcss -m -i ./src/styles/tailwind-entry.scss -o ./dist/index.css",
    "build:manifest": "tsx src/mcp/generate-manifest.ts",
    "build:mcp": "node tools/build-mcp.mjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:check": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:run": "vitest run",
    "verify:agent-hook": "npm run typecheck && npm run lint:check && npm run test:run",
    "format": "prettier --check .",
    "format-fix": "prettier --write .",
    "preview": "vite preview",
    "storybook": "concurrently \"npm run storybook:css\" \"storybook dev -p 6006\"",
    "storybook:css": "tailwindcss -w -i ./src/styles/tailwind-entry.scss -o ./src/index.css",
    "build-storybook": "concurrently \"npm run build-storybook:css\" \"storybook build\"",
    "build-storybook:css": "tailwindcss -m -i ./src/styles/tailwind-entry.scss -o ./src/index.css",
    "prepare": "husky",
    "publish:dry": "npm publish --access public --dry-run",
    "test": "vitest --coverage",
    "storybook-docs": "storybook dev --docs",
    "build-storybook-docs": "storybook build --docs"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "npm run lint"
    ]
  },
  "overrides": {
    "lodash": "4.18.1",
    "dompurify": "3.4.1"
  },
  "dependencies": {
    "ag-grid-community": "^35.2.1",
    "ag-grid-react": "^35.2.1",
    "mime-types": "^3.0.2",
    "re-resizable": "^6.11.2",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "tailwind-merge": "^3.5.0"
  },
  "peerDependencies": {
    "@floating-ui/react": "^0.27.19",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@monaco-editor/react": "^4.7.0",
    "@tabler/icons-react": "^3.41.1",
    "@uiw/react-markdown-preview": "^5.2.0",
    "@uiw/react-md-editor": "^4.1.0",
    "classnames": "^2.5.1",
    "monaco-editor": "^0.55.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.1.2",
    "@eslint/js": "^9.39.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/addon-vitest": "^10.3.6",
    "@storybook/react-vite": "^10.3.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/jsdom": "^28.0.1",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.9",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.2.17",
    "eslint-plugin-tailwindcss": "^3.18.3",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.1.2",
    "postcss": "^8.5.6",
    "postcss-import": "^16.1.1",
    "prettier": "^3.8.3",
    "sass": "^1.99.0",
    "sass-embedded": "^1.99.0",
    "storybook": "^10.3.6",
    "storybook-addon-pseudo-states": "^10.3.6",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.20.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^7.1.5",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^3.2.4"
  }
}
